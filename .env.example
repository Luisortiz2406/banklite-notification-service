NODE_ENV=development
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
PORT=3005

# Notification DB (PostgreSQL) — la crea db-init (scripts/init-db-roles.sh).
DATABASE_URL=postgres://notification_svc:<DB_PASSWORD_NOTIFICATION>@localhost:5432/notification_db

# Debe coincidir con el JWT_SECRET del Auth Service: este servicio valida
# los tokens emitidos por Auth para GET /notifications/:id_user y PUT /notifications/:id/read.
JWT_SECRET=
STAFF_JWT_SECRET=

# POST /notifications y OTP por WhatsApp (uso interno): solo auth-service.
INTERNAL_TRUSTED_KEYS=auth:<clave-de-auth>

# RabbitMQ — se suscribe solo a los eventos mapeados con algún canal en
# src/notifications/channel-policy.ts (para notificar uno nuevo, mapéalo allí).
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=notification-service.all-events

# Gmail API, mismas credenciales que auth-service (README.md, sección 7.2).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# WhatsApp Business Cloud API de Meta
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# El idioma y el botón deben coincidir con la plantilla aprobada en Meta.
WHATSAPP_OTP_TEMPLATE_NAME=caedomi_codigo_verificacion
WHATSAPP_OTP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_OTP_INCLUDE_BUTTON=true

# Opcionales (estos son los valores por defecto).
# Reintentos de un evento que falla antes de mandarlo a la DLQ (<cola>.dlq).
EVENT_MAX_RETRIES=5
EVENT_RETRY_DELAY_MS=10000
