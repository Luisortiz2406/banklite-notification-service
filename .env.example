NODE_ENV=development
PORT=3005

# Notification DB (PostgreSQL) — ya está en POSTGRES_MULTIPLE_DATABASES del docker-compose.
DATABASE_URL=postgres://banklite:banklite@localhost:5432/notification_db

# Debe coincidir con el JWT_SECRET del Auth Service: este servicio valida
# los tokens emitidos por Auth para GET /notifications/:id_user y PUT /notifications/:id/read.
JWT_SECRET=super-secreto-cambiar-en-produccion

# Clave compartida con los demás servicios, para POST /notifications (uso interno).
# Debe ser idéntica al INTERNAL_API_KEY de auth-service / kyc-service.
INTERNAL_API_KEY=clave-interna-cambiar-en-produccion

# RabbitMQ — se suscribe a TODOS los eventos del exchange 'banklite.events'
# (routing key '#'), así que no hay que tocar este servicio cada vez que
# otro microservicio agrega un evento nuevo; solo hay que mapearlo en
# src/notifications/channel-policy.ts.
RABBITMQ_URL=amqp://banklite:banklite@localhost:5672
RABBITMQ_EXCHANGE=banklite.events
RABBITMQ_QUEUE=notification-service.all-events

# Gmail API, mismas credenciales que auth-service (README.md, sección 7.2).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# WhatsApp Business Cloud API de Meta
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# El idioma y el botón deben coincidir con la plantilla aprobada en Meta.
WHATSAPP_OTP_TEMPLATE_NAME=caedomi_codigo_verificacion
WHATSAPP_OTP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_OTP_INCLUDE_BUTTON=true
